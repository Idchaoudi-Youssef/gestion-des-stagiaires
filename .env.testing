# Configuration used by the test suite.
#
# It is committed on purpose: it holds no secret, it only makes the test
# environment explicit and reproducible. The values below are overridden by
# the <env> entries of phpunit.xml, which always have the priority.

APP_NAME="Gestion des Stagiaires"
APP_ENV=testing
APP_KEY=base64:z8zq/0GVZ5UIEMQ2eJLB9jx+cfEVUM+q2oYN3MQOtMs=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BCRYPT_ROUNDS=4

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
FILESYSTEM_DISK=local
